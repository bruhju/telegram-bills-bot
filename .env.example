# SOMENTE para desenvolvimento local (npm run dev). Em produção esses valores
# viram segredos no Workers: `npx wrangler secret put TELEGRAM_BOT_TOKEN` etc.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DB_PATH=./data/bills.db
RECEIPTS_DIR=./data/receipts
TZ=America/Sao_Paulo

# Usado só pelo script `npm run webhook:set` (aponta o Telegram para o Worker
# publicado). Ex.: https://telegram-bills-bot.SUA-SUBDOMINIO.workers.dev
WORKER_URL=

# OPCIONAL mas recomendado: segredo do webhook (mesmo valor no
# `npx wrangler secret put WEBHOOK_SECRET`). Só A-Za-z0-9_-.
WEBHOOK_SECRET=
